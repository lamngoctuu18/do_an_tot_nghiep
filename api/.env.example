# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# Database (MySQL) - sẽ tự CREATE DATABASE nếu chưa có
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123
DB_NAME=vton_shop

# JWT
JWT_SECRET=change-me-access-secret-please
JWT_REFRESH_SECRET=change-me-refresh-secret-please
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Virtual Try-On (Flask service)
VTON_URL=http://localhost:8000
VTON_TIMEOUT_MS=1200000

# Uploads
UPLOAD_DIR=uploads

# Auto-seed dữ liệu mẫu khi start (admin + 3 sản phẩm). Đặt false để tắt.
AUTO_SEED=true
