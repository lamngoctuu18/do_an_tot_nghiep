# Đổi đường dẫn theo máy của bạn
VTO_BASE_DIR=E:/virtual_try_on_data
HF_HOME=E:/virtual_try_on_data/huggingface
TRANSFORMERS_CACHE=E:/virtual_try_on_data/huggingface/transformers
HUGGINGFACE_HUB_CACHE=E:/virtual_try_on_data/huggingface/hub
TORCH_HOME=E:/virtual_try_on_data/torch

# Optional: pretrained acceleration/LoRA settings
# Hyper-SD LoRA checkpoint file in ByteDance/Hyper-SD
HYPERSD_CKPT=Hyper-SD15-8steps-CFG-lora.safetensors

# JSON map for cloth-type LoRA repos on Hugging Face
# Example:
# CLOTH_LORA_MAP={"tshirt":"owner/tshirt-lora","hoodie":"owner/hoodie-lora","jacket":"owner/jacket-lora","generic":"owner/generic-fashion-lora"}
CLOTH_LORA_MAP=
CLOTH_LORA_SCALE=0.65

# Optional: FAL Flux Klein 9B Try-On LoRA backend
FAL_KEY=
FAL_FLUX_LORA_PATH=https://huggingface.co/fal/flux-klein-9b-virtual-tryon-lora/resolve/main/flux-klein-tryon.safetensors
